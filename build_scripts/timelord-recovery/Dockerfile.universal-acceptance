ARG PACKAGE_IMAGE=gold-universal-deb:2.0.5
ARG UBUNTU_BASE=ubuntu:20.04
FROM ${PACKAGE_IMAGE} AS package
FROM ${UBUNTU_BASE} AS verify
ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PATH="/opt/gold/venv/bin:${PATH}" \
    GOLD_ROOT=/tmp/gold-runtime-smoke/mainnet \
    GOLD_KEYS_ROOT=/tmp/gold-runtime-smoke/keys \
    GOLD_ACCEPTANCE_SECONDS=480
COPY --from=package /universal-out /out
RUN apt-get -o Acquire::Retries=3 update \
    && apt-get -o Acquire::Retries=3 install -y --no-install-recommends binutils \
    && (test -x /usr/bin/gold || apt-get install -y --no-install-recommends binutils-gold) \
    && sha256sum /usr/bin/gold > /out/binutils-gold-before.sha256 \
    && apt-get -o Acquire::Retries=3 install -y --no-install-recommends \
    /out/gold-blockchain-cli_2.0.5_amd64.deb \
    && sha256sum -c /out/binutils-gold-before.sha256 \
    && rm -rf /var/lib/apt/lists/*
COPY build_scripts/timelord-recovery /checks
WORKDIR /opt/gold/venv/lib/python3.8/site-packages
RUN --network=none /opt/gold/venv/bin/python /checks/verify_portable_runtime.py \
    && gold version && python -m pip check
RUN --network=none GOLD_TEST_REAL_IMPORTS=1 python chia/_tests/timelord/test_peak_recovery.py \
    && python chia/_tests/timelord/test_iteration_consistency.py \
    && GOLD_TEST_REAL_IMPORTS=1 python -m unittest chia._tests.timelord.test_candidate_refresh \
    && python /checks/smoke_test.py \
    && cp /opt/gold-image-verification.json /out/deb-vdf-verification.json
CMD ["/bin/sh", "-c", "set -eu; python /checks/docker_runtime_acceptance.py; python /checks/verify_deb_installation.py"]
